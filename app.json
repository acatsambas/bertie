{
  "expo": {
    "name": "Bertie",
    "slug": "Bertie",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "web": {
      "favicon": "./src/assets/favicon.png",
      "name": "Bertie",
      "shortName": "Bertie",
      "lang": "en",
      "scope": "/",
      "themeColor": "#565EAF",
      "backgroundColor": "#FDF9F6",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "src": "/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar"
    ]
  }
}

{
  "name": "bertie",
  "version": "1.5.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "build:web": "expo export -p web",
    "check:format": "oxfmt --check",
    "check:knip": "knip",
    "check:lint": "oxlint .",
    "check:types": "tsc --noEmit",
    "check": "pnpm check:format && pnpm check:knip && pnpm check:lint && pnpm check:types",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --config services/firebase/firebase.json --project production",
    "fix:format": "oxfmt .",
    "fix:lint": "oxlint --fix .",
    "fix": "pnpm fix:lint && pnpm fix:format",
    "gpt": "tsx src/gpt/discover-books.ts",
    "prepare": "lefthook install",
    "secrets:decrypt": "sh .github/scripts/decrypt.sh",
    "secrets:encrypt": "sh .github/scripts/encrypt.sh",
    "start:firebase": "firebase emulators:start --only auth,firestore --config services/firebase/firebase.json",
    "start": "expo start",
    "web:emulators": "EXPO_PUBLIC_USE_FIREBASE_EMULATORS=1 expo start --web",
    "web": "expo start --web"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.23.0"
  },
  "packageManager": "pnpm@11.23.0",
  "dependencies": {
    "@expo-google-fonts/commissioner": "0.4.1",
    "@expo-google-fonts/goudy-bookletter-1911": "0.4.1",
    "@expo/metro-runtime": "6.1.2",
    "@invertase/react-native-apple-authentication": "2.5.0",
    "@legendapp/list": "2.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/hooks": "100.1.0",
    "@react-native-google-signin/google-signin": "16.0.0",
    "@react-navigation/bottom-tabs": "7.8.5",
    "@react-navigation/native": "7.1.20",
    "@react-navigation/native-stack": "7.6.3",
    "@react-navigation/stack": "7.6.4",
    "@rneui/base": "4.0.0-rc.8",
    "@rneui/themed": "4.0.0-rc.8",
    "@tanstack/react-query": "5.90.9",
    "expo": "54.0.37",
    "expo-apple-authentication": "8.0.8",
    "expo-constants": "18.0.14",
    "expo-font": "14.0.12",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "firebase": "12.6.0",
    "i18next": "25.6.2",
    "lodash.debounce": "4.0.8",
    "openai": "6.9.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "16.3.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-vector-icons": "10.3.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/lodash.debounce": "4.0.9",
    "@types/react": "19.1.17",
    "babel-plugin-module-resolver": "5.0.2",
    "eslint-plugin-expo": "1.1.0",
    "firebase-admin": "13.6.0",
    "firebase-tools": "14.11.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "lint-staged": "17.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-config-universe": "0.2.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}

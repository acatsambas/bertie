{
  "name": "bertie",
  "version": "1.5.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "build:web": "expo export -p web",
    "check:format": "oxfmt --check",
    "check:knip": "knip",
    "check:lint": "oxlint .",
    "check:types": "tsc --noEmit",
    "check": "pnpm check:format && pnpm check:knip && pnpm check:lint && pnpm check:types",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --config services/firebase/firebase.json --project production",
    "dev": "concurrently -k -n firebase,web -c blue,magenta \"pnpm start:firebase\" \"wait-on tcp:127.0.0.1:9099 tcp:127.0.0.1:8080 && pnpm web:emulators\"",
    "fix:format": "oxfmt .",
    "fix:lint": "oxlint --fix .",
    "fix": "pnpm fix:lint && pnpm fix:format",
    "gpt": "tsx src/gpt/discover-books.ts",
    "prepare": "lefthook install",
    "secrets:decrypt": "sh .github/scripts/decrypt.sh",
    "secrets:encrypt": "sh .github/scripts/encrypt.sh",
    "start:firebase": "firebase emulators:start --only auth,firestore --config services/firebase/firebase.json",
    "start": "expo start",
    "web:emulators": "EXPO_PUBLIC_USE_FIREBASE_EMULATORS=1 expo start --web",
    "web": "expo start --web"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.23.0"
  },
  "packageManager": "pnpm@11.23.0",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/commissioner": "0.4.1",
    "@expo-google-fonts/goudy-bookletter-1911": "0.4.1",
    "@expo/metro-runtime": "57.0.16",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@legendapp/list": "2.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/hooks": "100.1.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-native-vector-icons/feather": "13.1.4",
    "@react-native-vector-icons/material-design-icons": "13.1.4",
    "@react-native-vector-icons/octicons": "21.1.4",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@react-navigation/stack": "7.11.2",
    "@rneui/base": "5.0.0",
    "@rneui/themed": "5.0.0",
    "@tanstack/react-query": "5.103.1",
    "expo": "57.0.24",
    "expo-apple-authentication": "57.0.2",
    "expo-constants": "57.0.19",
    "expo-font": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "firebase": "12.19.0",
    "i18next": "26.4.2",
    "lodash.debounce": "4.0.8",
    "openai": "7.20.0",
    "postal-code-checker": "2.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.14",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-render-html": "6.3.4",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/lodash.debounce": "4.0.9",
    "@types/react": "19.2.18",
    "@types/react-native-vector-icons": "6.4.18",
    "babel-plugin-module-resolver": "5.0.2",
    "concurrently": "10.0.5",
    "eslint-plugin-expo": "1.1.0",
    "firebase-admin": "14.4.0",
    "firebase-tools": "15.30.2",
    "knip": "6.37.0",
    "lefthook": "2.1.14",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-config-universe": "0.2.0",
    "oxlint-tsgolint": "7.0.2002",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "wait-on": "9.1.0"
  }
}

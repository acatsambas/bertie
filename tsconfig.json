{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "paths": {
      "components/*": ["./src/components/*"],
      "api/*": ["./src/api/*"],
      "assets/*": ["./src/assets/*"],
      "lib/*": ["./src/lib/*"],
      "gpt/*": ["./src/gpt/*"],
      "navigation/*": ["./src/navigation/*"],
      "screens/*": ["./src/screens/*"],
      "styles/*": ["./src/styles/*"],
      "utils/*": ["./src/utils/*"],
      "locales/*": ["./src/locales/*"],
      "contexts/*": ["./src/contexts/*"],
      "hooks/*": ["./src/hooks/*"]
    }
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js"]
}
